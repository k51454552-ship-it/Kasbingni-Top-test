<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kasbimni Top</title>
<style>
:root{
  --bg:#f7f8fb; --surface:#ffffff; --text:#1a1d29; --text-dim:#5b6072;
  --border:#e4e6ee; --primary:#3d5af1; --primary-dark:#2c41c9; --accent:#00b894;
  --shadow:0 2px 12px rgba(20,24,50,0.06);
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#12141c; --surface:#1a1d29; --text:#eef0f6; --text-dim:#9599ab;
    --border:#2a2e3d; --primary:#5b74ff; --primary-dark:#7c8fff; --accent:#00d3a0;
    --shadow:0 2px 12px rgba(0,0,0,0.4);
  }
}
:root[data-theme="dark"]{
  --bg:#12141c; --surface:#1a1d29; --text:#eef0f6; --text-dim:#9599ab;
  --border:#2a2e3d; --primary:#5b74ff; --primary-dark:#7c8fff; --accent:#00d3a0;
  --shadow:0 2px 12px rgba(0,0,0,0.4);
}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
*{box-sizing:border-box;}
body{
  margin:0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  background:var(--bg); color:var(--text); min-height:100%; line-height:1.5;
}
.wrap{max-width:960px; margin:0 auto; padding:0 20px;}
header{
  position:sticky; top:0; z-index:10; background:var(--surface);
  border-bottom:1px solid var(--border); padding-top:calc(env(safe-area-inset-top,0px) + 14px);
}
.nav{display:flex; align-items:center; justify-content:space-between; padding:0 20px 14px; max-width:960px; margin:0 auto;}
.logo{font-weight:700; font-size:19px; letter-spacing:-0.02em; color:var(--text); text-decoration:none; display:flex; align-items:center; gap:8px;}
.logo-dot{width:9px;height:9px;border-radius:50%;background:var(--primary);}
.navlinks{display:flex; gap:6px;}
.navlinks button{
  background:none; border:none; color:var(--text-dim); font-size:14.5px; padding:8px 14px;
  border-radius:8px; cursor:pointer; font-weight:500; transition:.15s;
}
.navlinks button:hover{background:var(--bg); color:var(--text);}
.navlinks button.active{color:var(--primary); background:rgba(61,90,241,0.1);}
main{max-width:960px; margin:0 auto; padding:32px 20px 80px;}
.view{display:none;}
.view.active{display:block; animation:fadein .25s ease;}
@keyframes fadein{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}

/* Home */
.hero{text-align:center; padding:56px 12px 40px;}
.hero h1{font-size:clamp(30px,5vw,46px); font-weight:800; letter-spacing:-0.03em; margin:0 0 16px; line-height:1.12;}
.hero p{color:var(--text-dim); font-size:17px; max-width:520px; margin:0 auto 30px;}
.btn{
  display:inline-block; background:var(--primary); color:#fff; border:none; padding:14px 30px;
  border-radius:12px; font-size:16px; font-weight:600; cursor:pointer; text-decoration:none;
  transition:.15s; box-shadow:0 4px 14px rgba(61,90,241,0.3);
}
.btn:hover{background:var(--primary-dark); transform:translateY(-1px);}
.btn.secondary{background:var(--surface); color:var(--text); border:1px solid var(--border); box-shadow:none;}
.stats{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:48px;}
.stat{background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:20px 10px; text-align:center; box-shadow:var(--shadow);}
.stat b{display:block; font-size:26px; font-weight:800; color:var(--primary);}
.stat span{font-size:12.5px; color:var(--text-dim);}
@media (max-width:600px){.stats{grid-template-columns:repeat(2,1fr);}}

/* Quiz */
.quiz-card{background:var(--surface); border:1px solid var(--border); border-radius:18px; padding:32px 28px; box-shadow:var(--shadow); max-width:640px; margin:0 auto;}
.progress-wrap{display:flex; align-items:center; gap:12px; margin-bottom:26px;}
.progress-bar{flex:1; height:6px; background:var(--border); border-radius:4px; overflow:hidden;}
.progress-fill{height:100%; background:var(--primary); border-radius:4px; transition:width .3s;}
.progress-label{font-size:13px; color:var(--text-dim); font-weight:600; white-space:nowrap;}
.qtext{font-size:20px; font-weight:700; margin:0 0 24px; letter-spacing:-0.01em;}
.options{display:flex; flex-direction:column; gap:10px;}
.opt{
  text-align:left; background:var(--bg); border:1.5px solid var(--border); border-radius:12px;
  padding:14px 16px; font-size:15px; cursor:pointer; transition:.15s; color:var(--text);
}
.opt:hover{border-color:var(--primary);}
.opt.selected{border-color:var(--primary); background:rgba(61,90,241,0.08); font-weight:600;}
.quiz-nav{display:flex; justify-content:space-between; margin-top:28px;}
.quiz-nav button:disabled{opacity:.4; cursor:not-allowed;}

/* Results */
.result-header{text-align:center; margin-bottom:36px;}
.result-header h2{font-size:28px; font-weight:800; margin:0 0 8px;}
.result-header p{color:var(--text-dim); font-size:15.5px;}
.result-list{display:flex; flex-direction:column; gap:12px;}
.result-item{
  background:var(--surface); border:1px solid var(--border); border-radius:14px;
  padding:18px 20px; display:flex; align-items:center; gap:16px; box-shadow:var(--shadow);
}
.rank{font-size:15px; font-weight:800; color:var(--text-dim); width:26px; flex-shrink:0;}
.result-main{flex:1; min-width:0;}
.result-main h3{margin:0 0 4px; font-size:16.5px; font-weight:700;}
.result-main p{margin:0; font-size:13.5px; color:var(--text-dim); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.match-pct{font-size:18px; font-weight:800; color:var(--primary); width:52px; text-align:right; flex-shrink:0;}
.detail-btn{
  background:var(--bg); border:1px solid var(--border); color:var(--text); font-size:13px;
  padding:8px 14px; border-radius:9px; cursor:pointer; font-weight:600; flex-shrink:0;
}
.result-actions{text-align:center; margin-top:32px;}

/* Professions list */
.filters{display:flex; gap:10px; margin-bottom:24px; flex-wrap:wrap;}
.filters input, .filters select{
  padding:11px 14px; border-radius:10px; border:1.5px solid var(--border); background:var(--surface);
  color:var(--text); font-size:14.5px; font-family:inherit;
}
.filters input{flex:1; min-width:180px;}
.prof-count{color:var(--text-dim); font-size:13.5px; margin-bottom:16px;}
.prof-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:14px;}
.prof-card{
  background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:18px;
  cursor:pointer; transition:.15s; box-shadow:var(--shadow);
}
.prof-card:hover{border-color:var(--primary); transform:translateY(-2px);}
.prof-card h4{margin:0 0 6px; font-size:15.5px; font-weight:700;}
.prof-card .tag{display:inline-block; font-size:11.5px; color:var(--primary); background:rgba(61,90,241,0.1); padding:3px 9px; border-radius:6px; margin-bottom:8px; font-weight:600;}
.prof-card p{margin:0; font-size:13px; color:var(--text-dim); overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;}

/* Modal */
.modal-bg{position:fixed; inset:0; background:rgba(10,12,20,0.5); display:none; align-items:center; justify-content:center; z-index:100; padding:20px; backdrop-filter:blur(2px);}
.modal-bg.active{display:flex;}
.modal{background:var(--surface); border-radius:18px; max-width:520px; width:100%; max-height:85vh; overflow-y:auto; padding:28px; box-shadow:0 20px 60px rgba(0,0,0,0.3);}
.modal h3{margin:0 0 4px; font-size:21px; font-weight:800;}
.modal .tag{display:inline-block; font-size:12px; color:var(--primary); background:rgba(61,90,241,0.1); padding:4px 10px; border-radius:7px; margin-bottom:14px; font-weight:600;}
.modal-field{margin-bottom:14px;}
.modal-field b{display:block; font-size:12.5px; color:var(--text-dim); margin-bottom:3px; text-transform:uppercase; letter-spacing:.03em;}
.modal-field span{font-size:14.5px;}
.modal-close{display:block; margin:20px auto 0; background:var(--bg); border:1px solid var(--border); color:var(--text); padding:10px 24px; border-radius:10px; cursor:pointer; font-weight:600;}

footer{text-align:center; padding:30px 20px calc(30px + env(safe-area-inset-bottom,0px)); color:var(--text-dim); font-size:13px; border-top:1px solid var(--border);}
</style>
</head>
<body>

<header>
  <div class="nav">
    <a class="logo" href="#" onclick="showView('home');return false;"><span class="logo-dot"></span>Kasbimni Top</a>
    <div class="navlinks">
      <button onclick="showView('home')" id="nav-home" class="active">Bosh sahifa</button>
      <button onclick="startQuiz()" id="nav-quiz">Testni boshlash</button>
      <button onclick="showView('professions')" id="nav-professions">Kasblar</button>
    </div>
  </div>
</header>

<main>

  <section id="view-home" class="view active">
    <div class="hero">
      <h1>Kelajakdagi kasbingizni toping</h1>
      <p>10 ta savolga javob bering va sizga mos kelishi mumkin bo'lgan kasblarni aniqlang.</p>
      <button class="btn" onclick="startQuiz()">Testni boshlash</button>
    </div>
    <div class="stats">
      <div class="stat"><b id="stat-profs">350</b><span>kasb</span></div>
      <div class="stat"><b id="stat-qs">1000</b><span>savol</span></div>
      <div class="stat"><b>Tasodifiy</b><span>test</span></div>
      <div class="stat"><b>Avtomatik</b><span>natija</span></div>
    </div>
  </section>

  <section id="view-quiz" class="view">
    <div class="quiz-card">
      <div class="progress-wrap">
        <div class="progress-bar"><div class="progress-fill" id="progress-fill" style="width:10%"></div></div>
        <div class="progress-label" id="progress-label">1/10</div>
      </div>
      <div class="qtext" id="qtext"></div>
      <div class="options" id="options"></div>
      <div class="quiz-nav">
        <button class="btn secondary" id="btn-prev" onclick="prevQ()">Orqaga</button>
        <button class="btn" id="btn-next" onclick="nextQ()" disabled>Keyingi</button>
      </div>
    </div>
  </section>

  <section id="view-results" class="view">
    <div class="result-header">
      <h2>Test natijangiz tayyor!</h2>
      <p>Sizga mos kelishi mumkin bo'lgan kasblar:</p>
    </div>
    <div class="result-list" id="result-list"></div>
    <div class="result-actions">
      <button class="btn secondary" onclick="startQuiz()">Testni qayta boshlash</button>
    </div>
  </section>

  <section id="view-professions" class="view">
    <div class="filters">
      <input type="text" id="search-input" placeholder="Kasb nomini qidiring..." oninput="renderProfessions()">
      <select id="filter-cat" onchange="renderProfessions()"><option value="">Barcha kategoriyalar</option></select>
    </div>
    <div class="prof-count" id="prof-count"></div>
    <div class="prof-grid" id="prof-grid"></div>
  </section>

</main>

<footer>Kasbimni Top — kasb tanlashda yordamchi test tizimi</footer>

<div class="modal-bg" id="modal-bg" onclick="if(event.target===this)closeModal()">
  <div class="modal" id="modal-content"></div>
</div>

