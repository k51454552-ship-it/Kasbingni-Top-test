function showView(name){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-'+name).classList.add('active');
  document.querySelectorAll('.navlinks button').forEach(b=>b.classList.remove('active'));
  const navBtn = document.getElementById('nav-'+name);
  if(navBtn) navBtn.classList.add('active');
  if(name==='professions') renderProfessions();
  window.scrollTo({top:0, behavior:'instant'});
}

// ---- Quiz logic ----
let quizQuestions = [];
let quizAnswers = []; // index into options, or null
let currentQ = 0;

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]]=[a[j],a[i]];
  }
  return a;
}

function startQuiz(){
  const pool = shuffle(QUESTIONS);
  quizQuestions = pool.slice(0,10).map(q=>{
    const opts = shuffle(q.options);
    return {cat:q.cat, text:q.text, options:opts};
  });
  quizAnswers = new Array(10).fill(null);
  currentQ = 0;
  showView('quiz');
  renderQuestion();
}

function renderQuestion(){
  const q = quizQuestions[currentQ];
  document.getElementById('qtext').textContent = q.text;
  document.getElementById('progress-fill').style.width = ((currentQ+1)/10*100)+'%';
  document.getElementById('progress-label').textContent = (currentQ+1)+'/10';
  const optsDiv = document.getElementById('options');
  optsDiv.innerHTML = '';
  q.options.forEach((opt, idx)=>{
    const btn = document.createElement('button');
    btn.className = 'opt' + (quizAnswers[currentQ]===idx ? ' selected' : '');
    btn.textContent = opt.text;
    btn.onclick = ()=>{ quizAnswers[currentQ]=idx; renderQuestion(); };
    optsDiv.appendChild(btn);
  });
  document.getElementById('btn-prev').disabled = currentQ===0;
  const nextBtn = document.getElementById('btn-next');
  nextBtn.disabled = quizAnswers[currentQ]===null;
  nextBtn.textContent = currentQ===9 ? "Natijani ko'rish" : 'Keyingi';
}

function prevQ(){
  if(currentQ>0){ currentQ--; renderQuestion(); }
}
function nextQ(){
  if(quizAnswers[currentQ]===null) return;
  if(currentQ<9){ currentQ++; renderQuestion(); }
  else { computeResults(); }
}

function computeResults(){
  const userVec = {};
  CATS.forEach(c=>userVec[c]=0);
  quizQuestions.forEach((q,i)=>{
    const chosen = q.options[quizAnswers[i]];
    userVec[q.cat] += chosen.score;
  });
  // cosine similarity between userVec and each profession vector (restricted to answered cats for fairness)
  const answeredCats = CATS.filter(c=>userVec[c] > 0 || quizQuestions.some(q=>q.cat===c));
  function dot(a,b,keys){ return keys.reduce((s,k)=>s+a[k]*b[k],0); }
  function norm(a,keys){ return Math.sqrt(keys.reduce((s,k)=>s+a[k]*a[k],0)) || 1; }
  const keys = CATS;
  const uNorm = norm(userVec, keys);
  const scored = PROFESSIONS.map(p=>{
    const sim = uNorm===0 ? 0 : dot(userVec, p.vector, keys) / (uNorm * norm(p.vector, keys));
    return {p, pct: Math.max(0, Math.min(100, Math.round(sim*100)))};
  });
  scored.sort((a,b)=>b.pct-a.pct);
  const top10 = scored.slice(0,10);
  renderResults(top10);
}

function renderResults(top10){
  const list = document.getElementById('result-list');
  list.innerHTML = '';
  top10.forEach((item, i)=>{
    const div = document.createElement('div');
    div.className = 'result-item';
    div.innerHTML = `
      <div class="rank">${i+1}</div>
      <div class="result-main"><h3>${escapeHtml(item.p.name)}</h3><p>${escapeHtml(item.p.category)}</p></div>
      <div class="match-pct">${item.pct}%</div>
      <button class="detail-btn">Batafsil</button>
    `;
    div.querySelector('.detail-btn').onclick = ()=>openModal(item.p);
    list.appendChild(div);
  });
  showView('results');
}

// ---- Professions page ----
function renderProfessions(){
  const q = document.getElementById('search-input').value.trim().toLowerCase();
  const cat = document.getElementById('filter-cat').value;
  const filtered = PROFESSIONS.filter(p=>{
    const matchQ = !q || p.name.toLowerCase().includes(q);
    const matchC = !cat || p.category===cat;
    return matchQ && matchC;
  });
  document.getElementById('prof-count').textContent = filtered.length + " ta kasb topildi";
  const grid = document.getElementById('prof-grid');
  grid.innerHTML = '';
  filtered.slice(0,200).forEach(p=>{
    const card = document.createElement('div');
    card.className = 'prof-card';
    card.innerHTML = `<span class="tag">${escapeHtml(p.category)}</span><h4>${escapeHtml(p.name)}</h4><p>${escapeHtml(p.desc)}</p>`;
    card.onclick = ()=>openModal(p);
    grid.appendChild(card);
  });
}

function openModal(p){
  const modal = document.getElementById('modal-content');
