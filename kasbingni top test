    <div class="modal-field"><b>Ta'lim yo'nalishi</b><span>${escapeHtml(p.education)}</span></div>
    <div class="modal-field"><b>Foydali tillar</b><span>${escapeHtml(p.languages)}</span></div>
    <button class="modal-close" onclick="closeModal()">Yopish</button>
  `;
  document.getElementById('modal-bg').classList.add('active');
}
function closeModal(){ document.getElementById('modal-bg').classList.remove('active'); }

function escapeHtml(s){
  const d = document.createElement('div');
  d.textContent = s;
  return d.innerHTML;
}
